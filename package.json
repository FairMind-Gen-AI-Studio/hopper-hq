{
  "name": "scranton-hq",
  "version": "0.1.0",
  "description": "A local office building where you watch your coding-agent sessions work.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "scranton-hq": "dist/bin.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mod": "claude plugin validate mod && claude plugin validate . && claude plugin test mod",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.8.3",
    "vitest": "~3.2.4"
  }
}
