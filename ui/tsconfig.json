{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte"]
  },
  "include": [
    "**/*.ts",
    "**/*.svelte",
    "../src/core/types.ts",
    "../src/scene/types.ts",
    "../src/scene/palette.ts",
    "../src/scene/text.ts",
    "../src/scene/layout.ts"
  ]
}
